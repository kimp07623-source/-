                            pointRadius: 0
                        },
                        {
                            label: '샤를 법칙 연장선 (절대영도)',
                            data: [],
                            borderColor: '#94a3b8',
                            borderWidth: 1.5,
                            borderDash: [4, 4],
                            fill: false,
                            pointRadius: 0
                        },
                        {
                            label: '현재 상태점',
                            data: [],
                            backgroundColor: '#ef4444',
                            borderColor: '#ffffff',
                            borderWidth: 2,
                            pointRadius: 7,
                            pointHoverRadius: 9
                        }
                    ]
                },
                options: {
                    responsive: true,
                    maintainAspectRatio: false,
                    animation: { duration: 0 },
                    plugins: {
                        legend: { display: false },
                        tooltip: {
                            callbacks: {
                                label: function(context) {
                                    if (currentLaw === 'boyle') {
                                        return `부피: ${context.parsed.x} L, 압력: ${context.parsed.y} atm`;
                                    } else {
                                        return `온도: ${context.parsed.x} K, 부피: ${context.parsed.y} L`;
                                    }
                                }
                            }
                        }
                    },
                    scales: {
                        x: {
                            type: 'linear',
                            title: { display: true, text: '부피 V (L)', color: '#94a3b8', font: { size: 11 } },
                            grid: { color: 'rgba(255, 255, 255, 0.06)' },
                            ticks: { color: '#94a3b8', font: { size: 10 } }
                        },
                        y: {
                            type: 'linear',
                            title: { display: true, text: '압력 P (atm)', color: '#94a3b8', font: { size: 11 } },
                            grid: { color: 'rgba(255, 255, 255, 0.06)' },
                            ticks: { color: '#94a3b8', font: { size: 10 } }
                        }
                    }
                }
            });

            updateChartConfig();
        }

        function updateChartConfig() {
            if (!chartInstance) return;

            if (currentLaw === 'boyle') {
                chartInstance.options.scales.x.title.text = '부피 V (L)';
                chartInstance.options.scales.x.min = 0.5;
                chartInstance.options.scales.x.max = 5.5;

                chartInstance.options.scales.y.title.text = '압력 P (atm)';
                chartInstance.options.scales.y.min = 0.0;
                chartInstance.options.scales.y.max = 3.0;

                const curveData = [];
                for (let v = 0.8; v <= 5.2; v += 0.1) {
                    curveData.push({ x: parseFloat(v.toFixed(2)), y: parseFloat((2.5 / v).toFixed(2)) });
                }
                chartInstance.data.datasets[0].data = curveData;
                chartInstance.data.datasets[1].data = [];
            } else {
                chartInstance.options.scales.x.title.text = '절대온도 T (K)';
                chartInstance.options.scales.x.min = 0;
                chartInstance.options.scales.x.max = 600;

                chartInstance.options.scales.y.title.text = '부피 V (L)';
                chartInstance.options.scales.y.min = 0.0;
                chartInstance.options.scales.y.max = 5.5;

                const lineData = [];
                for (let t = 173; t <= 580; t += 10) {
                    lineData.push({ x: t, y: parseFloat(((2.5 / 300) * t).toFixed(2)) });
                }

                const dashedData = [
                    { x: 0, y: 0 },
                    { x: 173, y: parseFloat(((2.5 / 300) * 173).toFixed(2)) }
                ];

                chartInstance.data.datasets[0].data = lineData;
                chartInstance.data.datasets[1].data = dashedData;
            }

            chartInstance.update();
        }

        function updateChartData() {
            if (!chartInstance) return;

            if (currentLaw === 'boyle') {
                chartInstance.data.datasets[2].data = [
                    { x: parseFloat(state.V.toFixed(2)), y: parseFloat(state.P_atm.toFixed(2)) }
                ];
            } else {
                chartInstance.data.datasets[2].data = [
                    { x: parseFloat(state.T_K.toFixed(1)), y: parseFloat(state.V.toFixed(2)) }
                ];
            }

            chartInstance.update('none');
        }

        // --- SHARE & EXPORT LOGIC ---
        function openShareModal() {
            const modal = document.getElementById('shareModal');
            modal.classList.remove('opacity-0', 'pointer-events-none');
            
            // Generate QR Code dynamically for current URL
            const qrContainer = document.getElementById('qrcode');
            qrContainer.innerHTML = '';
            const currentURL = window.location.href;

            qrCodeObj = new QRCode(qrContainer, {
                text: currentURL,
                width: 128,
                height: 128,
                colorDark : "#0f172a",
                colorLight : "#ffffff",
                correctLevel : QRCode.CorrectLevel.H
            });
        }

        function closeShareModal() {
            const modal = document.getElementById('shareModal');
            modal.classList.add('opacity-0', 'pointer-events-none');
        }

        function copyCurrentURL() {
            const url = window.location.href;
            navigator.clipboard.writeText(url).then(() => {
                showToast("현재 주소가 클립보드에 복사되었습니다!");
            }).catch(() => {
                showToast("주소 복사 실패");
            });
        }

        function downloadHTMLFile() {
            const htmlContent = "<!DOCTYPE html>\n" + document.documentElement.outerHTML;
            const blob = new Blob([htmlContent], { type: "text/html;charset=utf-8" });
            const url = URL.createObjectURL(blob);
            const a = document.createElement("a");
            a.href = url;
            a.download = "gas_laws_simulator.html";
            document.body.appendChild(a);
            a.click();
            document.body.removeChild(a);
            URL.revokeObjectURL(url);
            showToast("HTML 파일 다운로드가 시작되었습니다!");
        }

        function copyDataReport() {
            const lawName = currentLaw === 'boyle' ? "보일의 법칙" : "샤를의 법칙";
            const report = `[이상기체 법칙 가상실험 결과 보고서]
실험 항목: ${lawName}
- 기체 압력(P): ${state.P_atm.toFixed(2)} atm (${state.P_kPa.toFixed(1)} kPa)
- 기체 부피(V): ${state.V.toFixed(2)} L
- 섭씨 온도: ${state.T_C.toFixed(2)} ℃
- 절대 온도(T): ${state.T_K.toFixed(2)} K
- 기체 입자 평균속도: ${Math.round(500 * state.speedFactor)} m/s`;

            navigator.clipboard.writeText(report).then(() => {
                showToast("실험 결과 보고서가 복사되었습니다!");
            });
        }

        function showToast(msg) {
            const toast = document.getElementById('toast');
            document.getElementById('toastMsg').innerText = msg;
            toast.classList.remove('opacity-0');
            toast.classList.add('toast-animate');

            setTimeout(() => {
                toast.classList.add('opacity-0');
                toast.classList.remove('toast-animate');
            }, 2500);
        }
    </script>
</body>
</html>
