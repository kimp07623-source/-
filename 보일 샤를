        function setupCanvasInteraction() {
            const handleStart = (clientX, clientY) => {
                const rect = simCanvas.getBoundingClientRect();
                const y = clientY - rect.top;
                const x = clientX - rect.left;

                if (x >= containerBounds.x - 20 && x <= containerBounds.x + containerBounds.width + 20) {
                    if (Math.abs(y - containerBounds.y) < 35) {
                        isDraggingPiston = true;
                        document.getElementById('dragTooltip').style.opacity = '0';
                    }
                }
            };

            const handleMove = (clientY) => {
                if (!isDraggingPiston) return;
                const rect = simCanvas.getBoundingClientRect();
                const mouseCanvasY = clientY - rect.top;

                let newH = containerBounds.bottom - mouseCanvasY;
                newH = Math.max(containerBounds.minH, Math.min(containerBounds.maxH, newH));

                const newV = (newH / containerBounds.maxH) * 5.0;

                if (currentLaw === 'boyle') {
                    setVolumePreset(newV.toFixed(2));
                } else {
                    const newTK = (newV / 2.5) * 300;
                    const newTC = newTK - 273.15;
                    setTempPreset(Math.max(-100, Math.min(300, newTC)));
                }
            };

            const handleEnd = () => { isDraggingPiston = false; };

            simCanvas.addEventListener('mousedown', (e) => handleStart(e.clientX, e.clientY));
            window.addEventListener('mousemove', (e) => handleMove(e.clientY));
            window.addEventListener('mouseup', handleEnd);

            simCanvas.addEventListener('touchstart', (e) => {
                if (e.touches.length > 0) handleStart(e.touches[0].clientX, e.touches[0].clientY);
            }, { passive: true });

            window.addEventListener('touchmove', (e) => {
                if (e.touches.length > 0) handleMove(e.touches[0].clientY);
            }, { passive: true });

            window.addEventListener('touchend', handleEnd);
        }

        function animLoop() {
            renderSimulation();
            requestAnimationFrame(animLoop);
        }

        function renderSimulation() {
            const rect = simCanvas.getBoundingClientRect();
            const width = rect.width;
            const height = rect.height;

            ctx.clearRect(0, 0, width, height);

            const paddingX = width * 0.18;
            const boxW = width - (paddingX * 2);
            const maxBoxH = height * 0.72;
            const bottomY = height * 0.88;

            const targetBoxH = (state.V / 5.0) * maxBoxH;
            
            containerBounds.height += (targetBoxH - containerBounds.height) * 0.3;
            containerBounds.y = bottomY - containerBounds.height;
            containerBounds.x = paddingX;
            containerBounds.width = boxW;
            containerBounds.bottom = bottomY;

            const cX = containerBounds.x;
            const cY = containerBounds.y;
            const cW = containerBounds.width;
            const cH = containerBounds.height;

            ctx.save();
            ctx.fillStyle = 'rgba(15, 23, 42, 0.7)';
            ctx.fillRect(cX, cY, cW, cH);

            const glassGrad = ctx.createLinearGradient(cX, cY, cX + cW, cY);
            glassGrad.addColorStop(0, 'rgba(255, 255, 255, 0.12)');
            glassGrad.addColorStop(0.1, 'rgba(255, 255, 255, 0.03)');
            glassGrad.addColorStop(0.9, 'rgba(255, 255, 255, 0.03)');
            glassGrad.addColorStop(1, 'rgba(255, 255, 255, 0.12)');
            ctx.fillStyle = glassGrad;
            ctx.fillRect(cX, cY, cW, cH);

            ctx.strokeStyle = '#475569';
            ctx.lineWidth = 3;
            ctx.beginPath();
            ctx.moveTo(cX, cY - 15);
            ctx.lineTo(cX, cY + cH);
            ctx.lineTo(cX + cW, cY + cH);
            ctx.lineTo(cX + cW, cY - 15);
            ctx.stroke();

            ctx.fillStyle = '#334155';
            ctx.fillRect(cX - 10, cY + cH, cW + 20, 10);
            ctx.restore();

            if (!isPaused) updateParticlesPhysics();

            drawParticles();
            drawShockwaves();
            drawPiston(cX, cY, cW);
            drawPressureGauge(cX + cW + 10, cY + cH * 0.5);
        }

        function updateParticlesPhysics() {
            const speed = state.speedFactor;
            const cX = containerBounds.x;
            const cY = containerBounds.y;
            const cW = containerBounds.width;
            const cH = containerBounds.height;
            const cBottom = containerBounds.bottom;

            particles.forEach((p) => {
                p.x += p.vx * speed;
                p.y += p.vy * speed;

                if (p.x - p.radius < cX) {
                    p.x = cX + p.radius;
                    p.vx *= -1;
                    addShockwave(p.x, p.y);
                } else if (p.x + p.radius > cX + cW) {
                    p.x = cX + cW - p.radius;
                    p.vx *= -1;
                    addShockwave(p.x, p.y);
                }

                if (p.y + p.radius > cBottom) {
                    p.y = cBottom - p.radius;
                    p.vy *= -1;
                    addShockwave(p.x, p.y);
                }

                if (p.y - p.radius < cY) {
                    p.y = cY + p.radius;
                    p.vy = Math.abs(p.vy);
                    addShockwave(p.x, p.y);
                }
            });

            for (let i = 0; i < particles.length; i++) {
                for (let j = i + 1; j < particles.length; j++) {
                    const p1 = particles[i];
                    const p2 = particles[j];
                    const dx = p2.x - p1.x;
                    const dy = p2.y - p1.y;
                    const dist = Math.sqrt(dx * dx + dy * dy);
                    const minDist = p1.radius + p2.radius;

                    if (dist < minDist && dist > 0) {
                        const angle = Math.atan2(dy, dx);
                        const sin = Math.sin(angle);
                        const cos = Math.cos(angle);

                        let vx1 = p1.vx * cos + p1.vy * sin;
                        let vy1 = p1.vy * cos - p1.vx * sin;
                        let vx2 = p2.vx * cos + p2.vy * sin;
                        let vy2 = p2.vy * cos - p2.vx * sin;

                        const tempVx = vx1;
                        vx1 = vx2;
                        vx2 = tempVx;

                        const overlap = minDist - dist;
                        p1.x -= (overlap / 2) * cos;
                        p1.y -= (overlap / 2) * sin;
                        p2.x += (overlap / 2) * cos;
                        p2.y += (overlap / 2) * sin;

                        p1.vx = vx1 * cos - vy1 * sin;
                        p1.vy = vy1 * cos + vx1 * sin;
                        p2.vx = vx2 * cos - vy2 * sin;
                        p2.vy = vy2 * cos + vx2 * sin;
                    }
                }
            }
        }

        function drawParticles() {
            let color = '#818cf8';
            if (state.T_C > 80) color = '#f87171';
            else if (state.T_C < 0) color = '#38bdf8';

            particles.forEach(p => {
                ctx.save();
                ctx.beginPath();
                ctx.arc(p.x, p.y, p.radius, 0, Math.PI * 2);
                ctx.fillStyle = color;
                ctx.shadowColor = color;
                ctx.shadowBlur = 8;
                ctx.fill();

                ctx.beginPath();
                ctx.arc(p.x - 1.5, p.y - 1.5, p.radius * 0.35, 0, Math.PI * 2);
                ctx.fillStyle = 'rgba(255, 255, 255, 0.8)';
                ctx.fill();
                ctx.restore();
            });
        }

        function addShockwave(x, y) {
            if (wallCollisions.length < 15) {
                wallCollisions.push({ x, y, radius: 2, alpha: 0.8 });
            }
        }

        function drawShockwaves() {
            for (let i = wallCollisions.length - 1; i >= 0; i--) {
                const wave = wallCollisions[i];
                ctx.save();
                ctx.beginPath();
                ctx.arc(wave.x, wave.y, wave.radius, 0, Math.PI * 2);
                ctx.strokeStyle = `rgba(245, 158, 11, ${wave.alpha})`;
                ctx.lineWidth = 1.5;
                ctx.stroke();
                ctx.restore();

                wave.radius += 1.2;
                wave.alpha -= 0.08;

                if (wave.alpha <= 0) {
                    wallCollisions.splice(i, 1);
                }
            }
        }

        function drawPiston(cX, cY, cW) {
            ctx.save();
            const pistonH = 16;
            const pGrad = ctx.createLinearGradient(cX, cY - pistonH, cX, cY);
            pGrad.addColorStop(0, '#94a3b8');
            pGrad.addColorStop(0.5, '#cbd5e1');
            pGrad.addColorStop(1, '#64748b');

            ctx.fillStyle = pGrad;
            ctx.fillRect(cX + 2, cY - pistonH, cW - 4, pistonH);

            ctx.fillStyle = '#f59e0b';
            ctx.fillRect(cX + 2, cY - pistonH + 4, 6, 8);
            ctx.fillRect(cX + cW - 8, cY - pistonH + 4, 6, 8);

            const rodW = 12;
            const rodX = cX + cW / 2 - rodW / 2;
            const rodGrad = ctx.createLinearGradient(rodX, 0, rodX + rodW, 0);
            rodGrad.addColorStop(0, '#64748b');
            rodGrad.addColorStop(0.5, '#f1f5f9');
            rodGrad.addColorStop(1, '#475569');

            ctx.fillStyle = rodGrad;
            ctx.fillRect(rodX, cY - pistonH - 45, rodW, 45);

            const handleW = 60;
            const handleX = cX + cW / 2 - handleW / 2;
            const handleY = cY - pistonH - 52;

            ctx.fillStyle = isDraggingPiston ? '#818cf8' : '#6366f1';
            ctx.shadowColor = '#6366f1';
            ctx.shadowBlur = isDraggingPiston ? 15 : 6;
            ctx.beginPath();
            ctx.roundRect(handleX, handleY, handleW, 12, 6);
            ctx.fill();

            ctx.fillStyle = '#ffffff';
            ctx.fillRect(handleX + handleW / 2 - 8, handleY + 4, 3, 4);
            ctx.fillRect(handleX + handleW / 2 - 1, handleY + 4, 3, 4);
            ctx.fillRect(handleX + handleW / 2 + 6, handleY + 4, 3, 4);

            ctx.restore();
        }

        function drawPressureGauge(gx, gy) {
            ctx.save();
            const gRadius = 22;

            ctx.beginPath();
            ctx.arc(gx, gy, gRadius, 0, Math.PI * 2);
            ctx.fillStyle = '#0f172a';
            ctx.strokeStyle = '#475569';
            ctx.lineWidth = 2.5;
            ctx.fill();
            ctx.stroke();

            ctx.strokeStyle = '#94a3b8';
            ctx.lineWidth = 1;
            for (let a = -Math.PI * 0.75; a <= Math.PI * 0.75; a += Math.PI * 0.3) {
                const tx1 = gx + Math.cos(a) * (gRadius - 4);
                const ty1 = gy + Math.sin(a) * (gRadius - 4);
                const tx2 = gx + Math.cos(a) * (gRadius - 8);
                const ty2 = gy + Math.sin(a) * (gRadius - 8);
                ctx.beginPath();
                ctx.moveTo(tx1, ty1);
                ctx.lineTo(tx2, ty2);
                ctx.stroke();
            }

            const pRatio = Math.min(1.0, state.P_atm / 3.0);
            const needleAngle = -Math.PI * 0.75 + pRatio * (Math.PI * 1.5);

            ctx.beginPath();
            ctx.moveTo(gx, gy);
            ctx.lineTo(gx + Math.cos(needleAngle) * (gRadius - 5), gy + Math.sin(needleAngle) * (gRadius - 5));
            ctx.strokeStyle = '#f59e0b';
            ctx.lineWidth = 2;
            ctx.stroke();

            ctx.beginPath();
            ctx.arc(gx, gy, 3, 0, Math.PI * 2);
            ctx.fillStyle = '#f59e0b';
            ctx.fill();

            ctx.fillStyle = '#94a3b8';
            ctx.font = 'bold 9px monospace';
            ctx.textAlign = 'center';
            ctx.fillText('P', gx, gy + 14);

            ctx.restore();
        }

        function initChart() {
            const chartCtx = document.getElementById('liveChart').getContext('2d');

            chartInstance = new Chart(chartCtx, {
                type: 'line',
                data: {
                    datasets: [
