        function resizeCanvas() {
            const rect = simCanvas.getBoundingClientRect();
            const dpr = window.devicePixelRatio || 1;
            simCanvas.width = rect.width * dpr;
            simCanvas.height = rect.height * dpr;
            ctx.scale(dpr, dpr);
        }

        function initParticles() {
            particles = [];
            for (let i = 0; i < N_PARTICLES; i++) {
                particles.push({
                    x: 0, y: 0,
                    vx: (Math.random() - 0.5) * 4,
                    vy: (Math.random() - 0.5) * 4,
                    radius: 5
                });
            }
            initParticlesPosition();
        }

        function initParticlesPosition() {
            const rect = simCanvas.getBoundingClientRect();
            const cWidth = rect.width;
            const cHeight = rect.height;

            const paddingX = cWidth * 0.18;
            const boxW = cWidth - (paddingX * 2);
            const maxBoxH = cHeight * 0.72;
            const bottomY = cHeight * 0.88;

            const boxH = (state.V / 5.0) * maxBoxH;
            const topY = bottomY - boxH;

            containerBounds = {
                x: paddingX,
                y: topY,
                width: boxW,
                height: boxH,
                bottom: bottomY,
                maxH: maxBoxH,
                minH: (1.0 / 5.0) * maxBoxH
            };

            particles.forEach(p => {
                p.x = containerBounds.x + p.radius + Math.random() * (containerBounds.width - p.radius * 2);
                p.y = containerBounds.y + p.radius + Math.random() * (containerBounds.height - p.radius * 2);
            });
        }

        function updateStateFromVariables() {
            if (currentLaw === 'boyle') {
                state.T_K = 300.00;
                state.T_C = 26.85;
                state.P_atm = 2.50 / state.V;
            } else {
                state.T_K = state.T_C + 273.15;
                state.V = 2.50 * (state.T_K / 300.00);
                state.P_atm = 1.00;
            }

            state.P_kPa = state.P_atm * 101.325;
            state.speedFactor = Math.sqrt(state.T_K / 300.00);
        }

